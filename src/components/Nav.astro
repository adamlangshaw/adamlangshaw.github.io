---
import { NAV, SITE } from '../data/site';
const { path } = Astro.props as { path: string };
const norm = (h: string) => (h === '/' ? '/' : h.replace(/\/$/, ''));
const current = norm(path);
---

<header class="site-nav">
  <nav class="wrap inner" aria-label="Primary">
    <a class="brand" href="/">{SITE.name}</a>
    <ul>
      {
        NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={norm(item.href) === current ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
