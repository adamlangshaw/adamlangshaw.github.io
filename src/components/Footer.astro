---
import { NAV, SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <span>&copy; {year} {SITE.name}</span>
    <ul>
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </div>
</footer>
