---
import '../styles/global.css';
import { ESSAYS } from '../data/essays';
import { SITE, NAV } from '../data/site';

interface Props {
  title: string;
  description?: string;
  path: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = SITE.description, path, jsonLd } = Astro.props;
const isNotFound = path === '/404.html' || path === '/404/';
const canonical = new URL(path, SITE.url).href;
const fullTitle =
  path === '/' ? "Adam Langshaw | Stanford '29, The Stanford Daily" : `${title} | ${SITE.name}`;
const essay = ESSAYS.find((a) => a.url === path);
const isEssay = Boolean(essay);
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': path === '/' ? 'ProfilePage' : path === '/contact/' ? 'ContactPage' : isNotFound || isEssay || path === '/credits/' ? 'WebPage' : 'CollectionPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: fullTitle,
  description,
  inLanguage: 'en',
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#person` },
  ...(path === '/' ? { mainEntity: { '@id': `${SITE.url}/#person` } } : isEssay ? { mainEntity: { '@id': `${canonical}#article` } } : {}),
};
const schemas = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.name, inLanguage: 'en' },
  pageSchema,
  ...(path === '/' || isNotFound ? [] : [{
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      ...(isEssay ? [{ '@type': 'ListItem', position: 2, name: 'Writing', item: `${SITE.url}/writing/` }] : []),
      { '@type': 'ListItem', position: isEssay ? 3 : 2, name: NAV.find((item) => item.href === path)?.label ?? title, item: canonical },
    ],
  }]),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#16140f" media="(prefers-color-scheme: dark)" />

<meta name="robots" content={isNotFound ? "noindex, follow" : "index, follow, max-image-preview:large"} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={isEssay ? "article" : "website"} />
{isEssay && <>
  <meta property="article:published_time" content={essay!.date} />
  <meta property="article:modified_time" content={essay!.date} />
  <meta property="article:author" content={`${SITE.url}/`} />
</>}
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL('/img/og.jpg', SITE.url).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Adam Langshaw" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@adamhlangshaw" />

<link rel="sitemap" href="/sitemap-index.xml" />

{
  schemas.length > 0 && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schemas).replace(/</g, '\\u003c')}
    />
  )
}
