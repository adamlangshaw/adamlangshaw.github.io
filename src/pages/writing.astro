---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import { WRITING } from '../data/writing';
import { CONTACT } from '../data/site';
---

<Page
  title="Writing"
  description="Opinion and sports columns by Adam Langshaw for The Stanford Daily, covering health policy, higher education, and politics."
>
  <header class="page-head">
    <h1>Writing</h1>
    <p class="lede">Every column for <em>The Stanford Daily</em>, newest first.</p>
  </header>

  <ul class="pieces rule-top">
    {
      WRITING.map((a) => (
        <li>
          <a class="piece" href={a.url} rel="noopener">
            <img class="thumb" src={a.image} alt={a.alt} loading="lazy" width="900" height="576" />
            <span class="mid">
              <span class="eyebrow tag">{a.category}</span>
              <h2 class="t">{a.title}</h2>
            </span>
            <span class="date tabnums">{a.display}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="archive">
    <a href={CONTACT.dailyArchive} rel="noopener">Author archive at The Stanford Daily <Icon name="arrow" /></a>
  </p>
</Page>

<style>
  .pieces { list-style: none; margin: 2rem 0 0; padding: 0; max-width: 60rem; }
  .piece {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 1rem 1.4rem;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    color: inherit;
  }
  .piece:hover { text-decoration: none; }
  .thumb {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 4px;
    background: var(--rule);
  }
  .tag { color: var(--accent); }
  .t {
    display: block;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.2rem;
    line-height: 1.3;
    margin: 0.15rem 0 0;
  }
  .piece:hover .t { color: var(--accent); }
  .date { font-size: 0.8rem; color: var(--muted); white-space: nowrap; grid-column: 2; }
  .archive {
    margin-top: 1.8rem;
    font-size: 0.95rem;
  }
  .archive a { display: inline-flex; align-items: center; gap: 0.35rem; }

  @media (min-width: 640px) {
    .piece { grid-template-columns: 150px 1fr auto; }
    .date { grid-column: auto; }
  }
</style>
