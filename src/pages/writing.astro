---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import { ESSAYS } from '../data/essays';
import { WRITING } from '../data/writing';
import { EDITORIALS } from '../data/editorials';
import { CONTACT, SITE } from '../data/site';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Writing by Adam Langshaw',
  numberOfItems: ESSAYS.length + WRITING.length,
  itemListElement: [
    ...ESSAYS.map((a) => ({ ...a, url: new URL(a.url, SITE.url).href, image: undefined, publisherName: SITE.name })),
    ...WRITING.map((a) => ({ ...a, publisherName: 'The Stanford Daily' })),
  ].map((a, i) => ({
    '@type': 'ListItem', position: i + 1,
    item: {
      '@type': 'Article', '@id': a.url, headline: a.title, url: a.url, datePublished: a.date,
      ...(a.image ? { image: new URL(a.image, SITE.url).href } : {}),
      ...('originalDate' in a ? { dateCreated: a.originalDate } : {}),
      inLanguage: 'en',
      author: { '@type': 'Person', '@id': `${SITE.url}/#person`, name: SITE.name, url: `${SITE.url}/` },
      publisher: a.publisherName === SITE.name
        ? { '@type': 'Person', '@id': `${SITE.url}/#person`, name: SITE.name, url: `${SITE.url}/` }
        : { '@type': 'Organization', name: 'The Stanford Daily', url: 'https://stanforddaily.com/' },
      articleSection: a.category,
    },
  })),
};
---

<Page
  title="Journalism & Essays"
  jsonLd={jsonLd}
  description="Essays on health policy and public life by Adam Langshaw, alongside opinion and sports writing for The Stanford Daily and collective Editorial Board work."
>
  <header class="page-head">
    <h1>Journalism &amp; Essays</h1>
    <p class="reading">Adam is Opinions Managing Editor and a member of <em>The Stanford Daily</em> Editorial Board.</p>
  </header>

  <section class="essays rule-top" aria-labelledby="essays">
    <h2 id="essays">Essays</h2>
    {ESSAYS.map((a) => (
      <a class="piece text-only" href={a.url}>
        <span class="mid"><span class="eyebrow tag">{a.category}</span><h3 class="t">{a.title}</h3><span class="essay-context">{a.description}</span></span>
        <span class="date tabnums">Written <time datetime={a.originalDate}>{a.originalDisplay}</time><br />Published <time datetime={a.date}>{a.display}</time></span>
      </a>
    ))}
  </section>
  <h2 class="bylined-heading">The Stanford Daily</h2>
  <ul class="pieces rule-top">
    {
      WRITING.map((a) => (
        <li>
          <a class:list={["piece", { "text-only": !a.image }]} href={a.url} rel="noopener">
            {a.image && <img class="thumb" src={a.image} alt={a.alt ?? ""} loading="lazy" width="900" height="576" />}
            <span class="mid">
              <span class="eyebrow tag">{a.category}</span>
              <h3 class="t">{a.title}</h3>
            </span>
            <time class="date tabnums" datetime={a.date}>{a.display}</time>
          </a>
        </li>
      ))
    }
  </ul>

  <p class="archive">
    <a href={CONTACT.dailyArchive} rel="noopener">Author archive at The Stanford Daily <Icon name="arrow" /></a>
  </p>
  <section class="editorials rule-top" aria-labelledby="editorial-board">
    <h2 id="editorial-board">Editorial Board</h2>
    <p class="reading">Collective editorials by the board on which Adam serves. These represent the board’s work, rather than individual authorship.</p>
    <ul class="pieces">
      {EDITORIALS.map((a) => (
        <li><a class="piece" href={a.url} rel="noopener">
          <img class="thumb" src={a.image} alt={a.alt} loading="lazy" width="900" height="675" />
          <span class="mid"><span class="eyebrow tag">{a.byline}</span><h3 class="t">{a.title}</h3></span>
          <time class="date tabnums" datetime={a.date}>{a.display}</time>
        </a></li>
      ))}
    </ul>
  </section>
</Page>

<style>
  .essays { max-width: 60rem; margin-top: 2rem; padding-top: 1.5rem; }
  .essays h2 { margin: 0; font-size: 1.5rem; }
  .essay-context { display: block; color: var(--muted); font-size: 0.9rem; margin-top: 0.5rem; max-width: 55ch; }
  .bylined-heading { margin: 2.5rem 0 0; font-size: 1.5rem; }
  .pieces { list-style: none; margin: 2rem 0 0; padding: 0; max-width: 60rem; }
  .piece {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 1rem 1.4rem;
    align-items: center;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    color: inherit;
  }
  .piece:hover { text-decoration: none; }
  .thumb {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 4px;
    background: var(--rule);
  }
  .tag { color: var(--accent); }
  .t {
    display: block;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.2rem;
    line-height: 1.3;
    margin: 0.15rem 0 0;
  }
  .piece:hover .t { color: var(--accent); }
  .date { font-size: 0.8rem; color: var(--muted); white-space: nowrap; grid-column: 2; }
  .text-only { grid-template-columns: 1fr; }
  .text-only .date { grid-column: 1; }
  .editorials { max-width: 60rem; margin-top: 3rem; padding-top: 1.5rem; }
  .editorials h2 { margin: 0; }
  .archive {
    margin-top: 1.8rem;
    font-size: 0.95rem;
  }
  .archive a { display: inline-flex; align-items: center; gap: 0.35rem; }

  @media (min-width: 640px) {
    .piece { grid-template-columns: 150px 1fr auto; }
    .date { grid-column: auto; }
    .text-only { grid-template-columns: 1fr auto; }
    .text-only .date { grid-column: auto; }
  }
</style>
