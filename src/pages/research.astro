---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline:
    'The prevalence and clinical characteristics of immigrant people with cystic fibrosis at a single center in Miami, Florida',
  isPartOf: { '@type': 'Periodical', name: 'Journal of Cystic Fibrosis' },
  datePublished: '2024',
  author: { '@type': 'Person', name: 'Adam Langshaw' },
  about: ['Cystic fibrosis', 'Health equity', 'Immigrant access to care'],
};
---

<Page
  title="Research"
  description="Research on health equity and access to care, including a co-authored study on cystic fibrosis in immigrant patients, presented at the North American Cystic Fibrosis Conference."
  jsonLd={jsonLd}
>
  <header class="page-head">
    <h1>Research</h1>
    <p class="lede">
      Health equity and access to care, with a focus on cystic fibrosis and immigrant
      patients.
    </p>
  </header>

  <article class="pub rule-top">
    <p class="eyebrow accent">Publication &middot; 2024</p>
    <h2>
      The prevalence and clinical characteristics of immigrant people with cystic fibrosis
      at a single center in Miami, Florida
    </h2>
    <p class="venue">
      <em>Journal of Cystic Fibrosis</em>, 2024 supplement. Co-authored through the
      University of Miami Miller School of Medicine.
    </p>
    <span class="affiliation">
      <img
        src="/img/logo/university-of-miami.png"
        alt="University of Miami"
        width="600"
        height="150"
      />
    </span>
    <p class="body reading">
      A single-center study describing how many people with cystic fibrosis at a Miami
      clinic are immigrants, and how their clinical characteristics and access to care
      compare with the wider patient population.
    </p>
    <p class="meta">
      Presented at the North American Cystic Fibrosis Conference, Boston, September 27,
      2024.
    </p>
    <p class="link">
      <a
        href="https://www.cysticfibrosisjournal.com/article/S1569-1993(24)01568-6/abstract"
        rel="noopener"
      >
        Read the abstract <Icon name="arrow" />
      </a>
    </p>
  </article>
</Page>

<style>
  .accent { color: var(--accent); }
  .pub { margin: 2.5rem 0 0; padding-top: 1.6rem; max-width: 56rem; }
  .pub h2 { font-size: clamp(1.35rem, 3.2vw, 1.65rem); line-height: 1.3; margin: 0.6rem 0 0; max-width: 42rem; }
  .venue { font-size: 0.92rem; color: var(--muted); margin: 0.7rem 0 0; }
  .affiliation {
    display: inline-flex;
    margin: 1.2rem 0 0;
    padding: 10px 14px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: #fff;
  }
  .affiliation img { width: 172px; height: auto; display: block; }
  .body { margin: 1rem 0 0; }
  .meta { font-size: 0.9rem; color: var(--muted); margin: 0.9rem 0 0; }
  .link { margin: 1rem 0 0; font-size: 0.98rem; }
  .link a { display: inline-flex; align-items: center; gap: 0.35rem; }
</style>
